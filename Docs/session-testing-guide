# ================================================================
# 1. BASIC SESSION - create, read, delete via SessionStore
# ================================================================
from django.contrib.sessions.backends.db import SessionStore

session = SessionStore()
session['cart'] = {'item_1': 2, 'item_2': 1}
session.save()

print(session.session_key)  # the session ID

session2 = SessionStore(session_key='the_key_you_got_above')
print(session2['cart'])
print(session2.get('cart'))

session2.delete()

# ================================================================
# 2. INSPECT ALL SESSIONS DIRECTLY FROM THE DB
# ================================================================
from django.contrib.sessions.models import Session

for s in Session.objects.all():
    print(s.session_key, s.expire_date, s.get_decoded())

