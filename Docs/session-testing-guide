# ================================================================
# 4. CART MERGE ON LOGIN (guest -> authenticated)
# ================================================================
from django.test import Client
from django.contrib.auth import get_user_model

c = Client()
c.get('/cart/')
c.session['cart'] = {'item_1': 3}
c.session.save()
guest_key = c.session.session_key

User = get_user_model()
user = User.objects.get(username='testuser')  # or create_user(...)
c.force_login(user)  # login() rotates the session key by default

print(c.session.session_key != guest_key)  # True: key rotated on login
print(c.session.get('cart'))  # confirm your merge logic carried the cart over

